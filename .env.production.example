# ---- docker compose ----
POSTGRES_USER=checkout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=checkout
API_PORT=3000
WEB_PORT=8080

# Public URL of the API as the browser sees it (no trailing slash).
# The SPA is built with this, so changing it requires a rebuild of `web`.
PUBLIC_API_ORIGIN=http://localhost:3000
TELEGRAM_BOT_URL=https://t.me/your_bot

# ---- read by the api + bot containers ----
WEB_ORIGIN=http://localhost:8080
API_ORIGIN=http://localhost:3000
PORT=3000
BETTER_AUTH_SECRET=change-me

TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# only if api.telegram.org is blocked on the server's network
TELEGRAM_API_ROOT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=

AWS_REGION=us-east-1
# AWS Marketplace SaaS fulfilment (creds need aws-marketplace:ResolveCustomer)
# Credentials come from AWS_ACCESS_KEY/AWS_SECRET_KEY above, or the standard chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / IAM role).
AWS_MARKETPLACE_REGION=us-east-1
AWS_MARKETPLACE_PRODUCT_CODE=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET_NAME=

CHECKOUT_MAIL=
CHECKOUT_MAIL_PASSWORD=
CHECKOUT_MAIL_PASSWORD2=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYSTACK_SECRET_KEY=

# legacy, unused by the bot
OPENAI_API_KEY=
